{
  "name": "career-ops",
  "version": "1.6.0",
  "description": "AI-powered job search pipeline built on Claude Code",
  "scripts": {
    "doctor": "node doctor.mjs",
    "verify": "node verify-pipeline.mjs",
    "normalize": "node normalize-statuses.mjs",
    "dedup": "node dedup-tracker.mjs",
    "merge": "node merge-tracker.mjs",
    "pdf": "node generate-pdf.mjs",
    "pdf:id": "node pdf-from-id.mjs",
    "pdf:queue": "node pdf-queue.mjs",
    "sync-check": "node cv-sync-check.mjs",
    "update:check": "node update-system.mjs check",
    "update": "node update-system.mjs apply",
    "rollback": "node update-system.mjs rollback",
    "liveness": "node check-liveness.mjs",
    "playwright:bypass": "node check-playwright-bypass.mjs",
    "ingest": "node ingest-urls.mjs",
    "validate:ingest": "node validate-ingest.mjs --latest",
    "scan:playwright": "node scan-playwright.mjs",
    "scan:websearch": "node scan-websearch.mjs",
    "scan:dedup-websearch": "node scripts/deduplicate-websearch.mjs",
    "scan:refresh-after": "node refresh-search-query-dates.mjs --days 14",
    "scan": "node scan-with-instrumentation.mjs",
    "scan:referral": "node scan-with-instrumentation.mjs --referral",
    "gemini:eval": "node gemini-eval.mjs"
  },
  "keywords": [
    "ai",
    "job-search",
    "claude-code",
    "career",
    "automation"
  ],
  "author": "Santiago Fernández de Valderrama <hi@santifer.io> (https://santifer.io)",
  "homepage": "https://santifer.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/santifer/career-ops"
  },
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.1",
    "playwright": "^1.58.1",
    "yaml": "^2.9.0"
  }
}
